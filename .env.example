# Copy to .env (never commit .env) for local cloud-mode testing, or set these in Render -> Environment.
# Leave SUPABASE_URL empty to run Atlas in local single-user mode.

# Claude API: tasks for all users are billed to this key.
ANTHROPIC_API_KEY=

# Supabase (Dashboard -> Project Settings -> API Keys)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...

# E2B sandboxes (e2b.dev dashboard -> API Keys)
E2B_API_KEY=e2b_...
# Name of the sandbox template built by deploy/e2b_template.py
E2B_TEMPLATE=atlas-sandbox

# Encrypts saved logins and connector tokens. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ATLAS_VAULT_KEY=

# Spend protection (1 credit is about $0.01 of AI usage)
ATLAS_USER_DAILY_CREDITS=100
ATLAS_GLOBAL_DAILY_CREDITS=1000
ATLAS_MAX_SANDBOXES=5
